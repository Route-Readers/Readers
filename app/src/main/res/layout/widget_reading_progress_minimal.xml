<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- 책 표지 및 제목 -->
    <LinearLayout
        android:id="@+id/book_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_book_cover"
            android:layout_width="32dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/book_cover_placeholder"
            android:contentDescription="책 표지" />

        <TextView
            android:id="@+id/widget_book_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="책 제목"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 플레이 버튼 (옵션) -->
        <ImageButton
            android:id="@+id/widget_play_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_play_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="독서 시작/정지"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- 친구가 읽고 있는 책 (옵션) -->
    <TextView
        android:id="@+id/widget_friend_reading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="친구가 읽는 책: 예시 책 제목"
        android:textSize="8sp"
        android:textColor="#4CAF50"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_reading_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textSize="9sp"
        android:textColor="#888888"
        android:layout_marginStart="8dp"
        android:layout_gravity="end"
        android:visibility="gone" /> <!-- Initially hidden -->

    <!-- 진도 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- 진도율과 진도바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:progressDrawable="@drawable/progress_bar_style"
                android:background="@drawable/progress_background" />

            <TextView
                android:id="@+id/widget_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginStart="8dp"
                android:minWidth="30dp"
                android:gravity="end" />

        </LinearLayout>

        <!-- 하단 텍스트 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="탭하여 독서 계속하기"
            android:textSize="8sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
